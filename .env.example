# URL base de la API REST (backend Node + Express, carpeta endpoints/).
# Obligatoria: sin ella la aplicación no arranca.
# Copia este archivo a .env y ajusta el valor según el entorno.
# Vite la lee en tiempo de compilación, por lo que requiere reiniciar `npm run dev` tras cambiarla.
VITE_API_BASE_URL=http://localhost:3000/api
