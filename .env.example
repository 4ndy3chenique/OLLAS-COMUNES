# URL base de la API REST (backend PHP, carpeta endpoints/).
# Obligatoria: sin ella la aplicación no arranca.
# Copia este archivo a .env y ajusta el valor según el entorno.
# Vite la lee en tiempo de compilación, por lo que requiere reiniciar `npm run dev` tras cambiarla.
VITE_API_BASE_URL=http://localhost:8080/api

# Plataforma Operativa (padrón, escaneo QR, cola offline): scaffold con datos DEMO, sin endpoints reales aún.
# Dejar apagado en producción.
VITE_OPERATIVO_HABILITADO=false
